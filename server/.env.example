NODE_ENV=production
PORT=5000

# Database / authentication
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/eazy_check
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin(s), comma-separated when more than one
CLIENT_URL=https://your-domain.com

# Optional: AI / storage / payments used by the existing application
GROQ_API_KEY=
REPLICATE_API_TOKEN=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://your-domain.com/subscription/callback

# WebRTC ICE configuration
# Public STUN servers are the fallback when TURN is not configured.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Production TURN server. Recommended for reliable calls across mobile
# networks, CGNAT and restrictive firewalls.
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=
